{
  "name": "godlights",
  "version": "0.1.3",
  "description": "Animated god ray/light beam effects for React — zero dependencies beyond React itself.",
  "type": "module",
  "main": "./dist/godlights.js",
  "module": "./dist/godlights.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/godlights.mjs",
      "require": "./dist/godlights.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "dist/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavoquinalha/godlights.git",
    "directory": "packages/godlights"
  },
  "homepage": "https://www.godlights.io/",
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "god-rays",
    "light-rays",
    "light-beams",
    "volumetric-light",
    "canvas",
    "react",
    "animation",
    "background",
    "hero",
    "visual-effects",
    "glow",
    "typescript",
    "nextjs",
    "vite"
  ],
  "license": "MIT"
}
